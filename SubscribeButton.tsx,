'use client';

import { useState } from 'react';
import AmazonIAP from '@/lib/amazon-iap';

export default function SubscribeButton() {
  const [loading, setLoading] = useState(false);

  const handleSubscribe = async () => {
    setLoading(true);

    try {
      const result =
        await AmazonIAP.subscribeToCartCue();

      if (!result?.active) {
        throw new Error(
          'Amazon did not confirm an active subscription.'
        );
      }

      alert(
        'Subscribed! Welcome to CartCue Pro 🎉'
      );

      window.location.href = '/';
    } catch (e: any) {
      const message =
        e?.message ||
        'Unable to start the Amazon subscription.';

      if (!/cancel/i.test(message)) {
        alert(
          'Subscribe via the Amazon Appstore: ' +
            message
        );
      }
    } finally {
      setLoading(false);
    }
  };

  return (
    <button
      onClick={handleSubscribe}
      disabled={loading}
      className="w-full mt-4 rounded-xl bg-black text-white font-bold py-4 px-6 text-center disabled:opacity-60"
      style={{
        background:
          'linear-gradient(90deg, #FF9900, #FF6600)',
      }}
    >
      {loading
        ? 'Connecting to Amazon...'
        : '🔓 Start 7-Day Free Trial — $4.99/month'}
    </button>
  );
}
