name: Build Android APK - CartCue Amazon IAP

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout CartCue
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Install dependencies
        run: npm install

      - name: Build Next.js app
        run: npm run build

      - name: Add Capacitor Android
        run: npx cap add android

      - name: Sync Capacitor
        run: npx cap sync android

      - name: Install Amazon Appstore SDK
        run: |
          mkdir -p android/app/libs
          JAR_SRC="amazon-iap/amazon-appstore-sdk-3.0.9.jar"
          JAR_DST="android/app/libs/amazon-appstore-sdk-3.0.9.jar"

          # Prefer a real binary JAR if present; otherwise rebuild from sdk-parts text.
          if [ -f "$JAR_SRC" ] && file "$JAR_SRC" | grep -qi 'zip\|java archive\|Jar'; then
            echo "Using existing binary JAR"
            cp "$JAR_SRC" "$JAR_DST"
          elif [ -d amazon-iap/sdk-parts ] && ls amazon-iap/sdk-parts/sdk-part-*.txt >/dev/null 2>&1; then
            echo "Rebuilding JAR from amazon-iap/sdk-parts/*.txt"
            cat amazon-iap/sdk-parts/sdk-part-*.txt | tr -d '\n\r ' | base64 -d > "$JAR_DST"
          elif [ -f "$JAR_SRC" ]; then
            # File exists but is base64 text (common upload mistake)
            echo "Decoding text JAR at $JAR_SRC"
            tr -d '\n\r ' < "$JAR_SRC" | base64 -d > "$JAR_DST" || {
              echo "Failed to decode $JAR_SRC — upload sdk-parts or a real binary JAR"
              exit 1
            }
          else
            echo "Missing Amazon SDK. Add amazon-iap/sdk-parts/ or a real amazon-appstore-sdk-3.0.9.jar"
            exit 1
          fi

          # Validate
          python3 - <<'PY'
          import zipfile, pathlib, sys
          p = pathlib.Path("android/app/libs/amazon-appstore-sdk-3.0.9.jar")
          print("JAR size:", p.stat().st_size)
          if not zipfile.is_zipfile(p):
              print("ERROR: reconstructed file is not a valid JAR")
              sys.exit(1)
          z = zipfile.ZipFile(p)
          if not any("PurchasingService" in n for n in z.namelist()):
              print("ERROR: JAR missing PurchasingService")
              sys.exit(1)
          print("Amazon SDK JAR OK")
          PY

      - name: Install Amazon authentication key
        run: |
          mkdir -p android/app/src/main/assets
          cp amazon-iap/AppstoreAuthenticationKey.pem \
            android/app/src/main/assets/AppstoreAuthenticationKey.pem

      - name: Install CartCue Amazon IAP plugin
        run: |
          mkdir -p android/app/src/main/java/com/cartcue/app

          cp amazon-iap/AmazonIAPPlugin.java \
            android/app/src/main/java/com/cartcue/app/AmazonIAPPlugin.java

          cp amazon-iap/MainActivity.java \
            android/app/src/main/java/com/cartcue/app/MainActivity.java

      - name: Add Amazon SDK to Gradle
        shell: bash
        run: |
          BUILD_GRADLE="android/app/build.gradle"

          if ! grep -q \
            "amazon-appstore-sdk-3.0.9.jar" \
            "$BUILD_GRADLE"
          then
            python3 - <<'PY'
from pathlib import Path

path = Path("android/app/build.gradle")
text = path.read_text()

needle = "dependencies {"

if needle not in text:
    raise SystemExit(
        "Could not find dependencies block."
    )

replacement = (
    needle
    + "\n"
    + "    implementation files('libs/amazon-appstore-sdk-3.0.9.jar')"
)

text = text.replace(
    needle,
    replacement,
    1
)

path.write_text(text)
PY
          fi

          cat "$BUILD_GRADLE"

      - name: Patch Android manifest for Amazon IAP
        shell: bash
        run: |
          MANIFEST="android/app/src/main/AndroidManifest.xml"

          python3 - <<'PY'
from pathlib import Path

path = Path(
    "android/app/src/main/AndroidManifest.xml"
)

text = path.read_text()

permission = (
    '<uses-permission '
    'android:name="com.amazon.inapp.purchasing.Permission.NOTIFY" />'
)

queries = """<queries>
        <package android:name="com.amazon.venezia" />
    </queries>"""

receiver = """<receiver
        android:name="com.amazon.device.iap.ResponseReceiver"
        android:exported="true"
        android:permission="com.amazon.inapp.purchasing.Permission.NOTIFY">
        <intent-filter>
            <action
                android:name="com.amazon.inapp.purchasing.NOTIFY" />
        </intent-filter>
    </receiver>"""

if permission not in text:
    text = text.replace(
        "<application",
        permission + "\n\n    <application",
        1
    )

if "<package android:name=\"com.amazon.venezia\"" not in text:
    text = text.replace(
        "<application",
        queries + "\n\n    <application",
        1
    )

if "com.amazon.device.iap.ResponseReceiver" not in text:
    text = text.replace(
        "</application>",
        "    " + receiver + "\n\n    </application>",
        1
    )

path.write_text(text)
PY

          cat "$MANIFEST"

      - name: Check Amazon files
        run: |
          test -f android/app/src/main/java/com/cartcue/app/AmazonIAPPlugin.java
          test -f android/app/src/main/java/com/cartcue/app/MainActivity.java
          test -f android/app/libs/amazon-appstore-sdk-3.0.9.jar
          test -f android/app/src/main/assets/AppstoreAuthenticationKey.pem

      - name: Verify Amazon ResponseReceiver
        run: |
          grep -q "com.amazon.device.iap.ResponseReceiver" \
            android/app/src/main/AndroidManifest.xml

      - name: Build debug APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug


      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: cartcue-amazon-iap-debug
